+  const openEx = ex.filter((e) => e.status !== "closed");
+  const atRisk = openEx.filter((e) => e.amount > 0 && e.interestHoursLeft < 24);
+  const proposed = (collections.matches || []).filter((m) => m.status !== "rejected").length;
