+  if (hasCap(perms, "extraction", "edit")) {
+    (collections.documents || []).filter((d) => d.status === "needs_review").forEach((d) => {
+      const n = d.fields.filter((f) => f.conf < 0.95 || (f.validator && !f.validator.ok)).length + d.lines.reduce((k, l) => k + Object.values(l).filter((v) => v[1] < 0.95).length, 0);
+      items.push({ id: d.id, tone: "amber", sort: 600, kind: "Check a document", step: 2, title: `Check ${n} value${n !== 1 ? "s" : ""} the system wasn't sure about`, detail: `${d.docType} · ${d.name}`, hint: "Everything else on it was read correctly", primary: { label: "Check values", run: () => nav(`/extraction?doc=${d.id}`) } });
+    });
+  }
+  if (hasCap(perms, "refunds", "edit")) {
+    (collections.refunds || []).filter((r) => r.status === "draft").forEach((r) => items.push({
+      id: r.id, tone: r.ageDays >= 4 ? "red" : "amber", sort: 300 - r.ageDays, kind: "Refund", step: 5, title: `Refund ${inr(r.amount)} to ${r.investor}`, detail: `${r.reason} · to ${r.bankAcct}`,
+      when: r.ageDays >= 5 ? "Late — interest is being added" : `${5 - r.ageDays} day${5 - r.ageDays !== 1 ? "s" : ""} before interest applies`,
+      hint: r.verified ? "Bank account already verified" : "Verify the bank account first", primary: { label: "Prepare refund", run: () => nav(`/refunds?refund=${r.id}`) },
+    }));
+  }
+  if (hasCap(perms, "ingestion", "edit")) {
+    (collections.files || []).filter((f) => ["drift", "unknown", "check_failed", "late", "missing"].includes(f.status)).forEach((f) => items.push({
+      id: f.id, tone: ["late", "missing"].includes(f.status) ? "red" : "amber", sort: 100, kind: "Bank file", step: 1,
+      title: { drift: `${f.bankName} changed its file layout`, unknown: `${f.bankName} sent a file we don't recognise`, check_failed: `${f.bankName} statement balances don't add up`, late: `${f.bankName} statement is late`, missing: `${f.bankName} statement not received` }[f.status],
+      detail: `Account ·${f.accountNumber.slice(-4)} · ${f.channel}`, hint: f.status === "drift" ? "The system has proposed the new mapping — confirm it" : "Retry or chase the bank",
+      primary: { label: f.status === "drift" ? "Review new layout" : "Open file", run: () => nav(`/ingestion?file=${f.id}`) },
+    }));
+  }
+  if (hasCap(perms, "bank_setup", "edit")) {
+    (collections.bank_config || []).filter((x) => x.status === "rejected" && x.owner === currentUser).forEach((x) => items.push({
+      id: x.id, tone: "amber", sort: 200, kind: "Rejected setup", title: `Fix ${x.bankName} ${maskAccount(x.accountNumber)} — sent back by checker`, detail: x.rejection?.comment || "", hint: "Make the change and resubmit",
+      primary: { label: "Fix setup", run: () => nav(`/bank-setup/edit/${x.id}`) },
+    }));
+  }
+  items.sort((a, b) => TONE_ORDER[a.tone] - TONE_ORDER[b.tone] || a.sort - b.sort);
+  return items;
+}
+
+function CutoffChip() {
+  const mins = Math.round((new Date(RELEASE_CUTOFF) - Date.now()) / 60000);
+  return <span className={"cutoff-chip" + (mins < 60 ? " hot" : "")}><Clock size={13} /> Fund release cut-off {mins > 0 ? `in ${Math.floor(mins / 60)}h ${mins % 60}m` : "passed"}</span>;
+}
+
+export default function Today() {
+  const { collections, perms, personaUser, act, audit, simple, currentUser } = useStore();
+  const nav = useNavigate();
+  const loc = useLocation();
+  const { steps, next } = useCycle();
+  const work = useWorkItems();
+  const approvals = useApprovals().filter((a) => !a.own);
+  const isChecker = hasCap(perms, "inbox", "approve");
+  const [note, setNote] = React.useState("");
+  const closeRef = React.useRef(null);
+  React.useEffect(() => { if (loc.hash === "#close") setTimeout(() => closeRef.current?.scrollIntoView({ behavior: "smooth" }), 200); }, [loc.hash]);
+
+  const first = personaUser.name.split(" ")[0];
+  const hour = new Date().getHours();
+  const greet = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
+  const todayStr = new Date().toDateString();
+  const doneToday = audit.filter((a) => a.user === first && !a.denied && new Date(a.ts).toDateString() === todayStr).length;
+  const reds = work.filter((i) => i.tone === "red").length;
+  const waitingMine = audit.length && [
+    ...(collections.matches || []).filter((m) => m.status === "pending" && m.owner === first),
+    ...(collections.exceptions || []).filter((e) => e.status === "pending_approval" && (e.closedBy === first)),
+    ...(collections.refunds || []).filter((r) => r.status === "pending" && (r.owner || "").startsWith(first)),
+    ...(collections.documents || []).filter((d) => d.status === "pending_checker" && d.owner === first),
+  ].length;
+
+  // The single next action for this person
+  const hero = isChecker && approvals.length
+    ? { eyebrow: "Do this first", title: `Approve ${approvals.length} item${approvals.length > 1 ? "s" : ""} your team sent you`, why: approvals.some((a) => a.urgent) ? "Some of them block today's fund release or hold bank file rows. Those are at the top." : "Makers can't finish their steps until you approve.", cta: { label: "Open approvals", path: "/approvals" } }
+    : next ? { eyebrow: `Step ${next.n} of 6 · by ${next.by}`, title: next.title, why: next.why, summary: next.summary, cta: next.cta, late: next.late }
+    : work.length ? { eyebrow: "Do this first", title: work[0].title, why: work[0].hint, cta: { label: work[0].primary.label, run: work[0].primary.run } }
+    : { eyebrow: "All clear", title: "Nothing is waiting for you right now", why: "New work appears here automatically. You can review today's dashboard or reports." };
+
+  const close = (collections.dayclose || [])[0] || { status: "open" };
+  const canSubmitClose = hasCap(perms, "match", "edit") || hasCap(perms, "release", "edit");
+  const canSignClose = hasCap(perms, "release", "approve");
+  const carried = (collections.exceptions || []).filter((e) => e.status !== "closed").length;
+  const submitClose = () => {
+    const res = act({ screen: "release", cap: "edit", kind: "dayclose", id: "day_today", patch: { status: "pending", submittedBy: currentUser, carried, note: note.trim(), submittedAt: new Date().toISOString() }, audit: { entityLabel: "Day close", action: "Submit day close", from: "Open", to: "Pending", comment: `${carried} items carried forward` } });
+    if (res.ok) toast.success(simple ? "Sent to your checker to sign off the day." : "Day close submitted for sign-off"); else toast.error(res.error);
+  };
+  const signClose = () => {
+    const res = act({ screen: "release", cap: "approve", kind: "dayclose", id: "day_today", target: { owner: close.submittedBy }, patch: { status: "closed", closedBy: currentUser, closedAt: new Date().toISOString() }, audit: { entityLabel: "Day close", action: "Sign off day", from: "Pending", to: "Closed" } });
+    if (res.ok) toast.success("Day signed off. Summary sent to AMCs."); else toast.error(res.error);
+  };
+  const daySummary = () => downloadCsv(`day_summary_${new Date().toISOString().slice(0, 10)}.csv`, ["Step", "Status", "Detail"], steps.map((s) => [s.title, s.state, s.summary]));
+
+  const list = isChecker ? approvals.slice(0, 6).map((a) => ({ id: a.id, tone: a.urgent ? "red" : "amber", kind: a.kind, title: a.title, detail: a.detail, hint: `From ${a.owner || "—"}`, primary: { label: a.review ? "Review" : "Review & approve", run: () => nav(a.review || "/approvals") } })) : work;
+
+  return (
+    <div className="today" data-testid="today">
+      <div className="today-head">
+        <div>
+          <div className="eyebrow-sm"><Sun size={13} /> {new Date().toLocaleDateString("en-IN", { weekday: "long", day: "numeric", month: "long" })}</div>
+          <h1>{greet}, {first}</h1>
+        </div>
+        <CutoffChip />
+      </div>
+
+      {/* 1. The ONE thing to do next */}
+      <div className={"next-card" + (hero.late ? " late" : "")} data-testid="next-action">
+        <div className="nc-body">
+          <div className="nc-eyebrow">{hero.eyebrow}{hero.late && <span className="nc-late">Running late</span>}</div>
+          <h2>{hero.title}</h2>
+          <p>{hero.why}</p>
+          {hero.summary && <div className="nc-sum">{hero.summary}</div>}
+        </div>
+        {hero.cta && <button className="btn btn-primary btn-lg" onClick={() => (hero.cta.run ? hero.cta.run() : nav(hero.cta.path))} data-testid="next-action-btn">{hero.cta.label} <ArrowRight size={16} /></button>}
+      </div>
+
+      {/* 2. Where the day stands */}
+      <section className="today-section">
+        <div className="ts-head"><h3>Today's reconciliation cycle</h3><span className="muted">{steps.filter((s) => s.state === "done").length} of 6 steps done · the whole team works through these in order · blue = where the team is now</span></div>
+        <CycleStepper steps={steps} mine={isChecker && approvals.length ? null : next?.key} />
+      </section>
+
+      {/* 3. Personal numbers */}
+      <div className="kpi-row">
+        <div className="kpi"><span>Done today</span><b>{doneToday}</b><small>actions by you</small></div>
+        <div className="kpi"><span>{isChecker ? "Waiting for you" : "On your list"}</span><b>{list.length}</b><small>{reds && !isChecker ? `${reds} urgent` : "—"}</small></div>
+        <div className="kpi"><span>Waiting for approval</span><b>{waitingMine || 0}</b><small>you've done your part</small></div>
+        <div className="kpi"><span>Realised today</span><b>{inrShort((collections.releases || [])[0]?.amount || 19874410000)}</b><small>ready for unit allotment</small></div>
+      </div>
+
+      {/* 4. The list */}
+      <section className="today-section">
+        <div className="ts-head"><h3>{isChecker ? "Waiting for your approval" : "Your list"}</h3>
+          <span className="muted">{isChecker ? <Link to="/approvals">See all {approvals.length} →</Link> : "Red first, then amber, then green"}</span></div>
+        {!simple || isChecker ? null : <div className="mw-key"><Light tone="red">Urgent — do first</Light><Light tone="amber">Please check</Light><Light tone="green">Quick — usually just say yes</Light></div>}
+        <div className="mw-list">
+          {list.map((it, i) => (
+            <div key={it.id} className={"mw-item tone-" + it.tone} data-testid={"mw-item-" + it.id}>
+              <span className="mw-num">{i + 1}</span>
+              <div className="mw-body">
+                <div className="mw-kind">{it.step && <span className="step-chip">Step {it.step}</span>}{it.kind}{it.light && <Light tone={it.tone}>{it.light}</Light>}</div>
+                <div className="mw-title">{it.title}</div>
+                <div className="mw-detail">{it.detail}</div>
+                <div className="mw-hint">{it.when && <span className={"mw-when " + it.tone}><Hourglass size={13} /> {it.when}</span>}{it.hint}</div>
+              </div>
+              <div className="mw-actions">
+                <button className="btn btn-primary mw-btn" onClick={it.primary.run} data-testid={"mw-do-" + it.id}>{it.primary.label}</button>
+                {it.secondary && <button className="btn btn-outline mw-btn-2" onClick={it.secondary.run} data-testid={"mw-no-" + it.id}>{it.secondary.label}</button>}
+                {it.more && <button className="link" onClick={it.more.run}>{it.more.label}</button>}
+              </div>
+            </div>
+          ))}
+          {list.length === 0 && <div className="mw-empty card"><PartyPopper size={30} /><h2>Nothing left for you</h2><p className="muted">New work appears here automatically.</p></div>}
+        </div>
+      </section>
+
+      {/* 5. Close the day */}
+      {(canSubmitClose || canSignClose) && (
+        <section className="today-section close-day card" ref={closeRef} id="close" data-testid="close-day">
+          <div className="ts-head"><h3><Flag size={16} /> Close the day</h3><span className={"pill " + (close.status === "closed" ? "pill-active" : close.status === "pending" ? "pill-pending" : "pill-draft")}><span className="dot" />{{ open: "Open", pending: "Waiting for sign-off", closed: "Closed" }[close.status]}</span></div>
+          <div className="cd-grid">
+            <ul className="cd-check">
+              {steps.slice(0, 5).map((s) => <li key={s.key} className={s.state}>{s.state === "done" ? <CheckCircle2 size={15} /> : <Hourglass size={15} />}<span><b>{s.title}</b> — {s.summary}</span></li>)}
+            </ul>
+            <div className="cd-side">
+              {close.status === "open" && canSubmitClose && <>
+                <p className="muted">Anything not finished is carried forward to tomorrow ({carried} open case{carried !== 1 ? "s" : ""}). Add a note for tomorrow's team.</p>
+                <textarea className="textarea" value={note} onChange={(e) => setNote(e.target.value)} placeholder="e.g. SBI statement still missing; chased RM at 3:10 PM" />
+                <button className="btn btn-primary" onClick={submitClose} data-testid="submit-close"><Flag size={14} /> Submit day close</button>
+              </>}
+              {close.status === "pending" && (canSignClose && !(close.submittedBy || "").startsWith(first) ? <>
+                <p>Submitted by <b>{close.submittedBy}</b>. {close.carried} item{close.carried !== 1 ? "s" : ""} carried forward.{close.note && <> Note: “{close.note}”</>}</p>
+                <button className="btn btn-success" onClick={signClose} data-testid="sign-close"><ShieldCheck size={14} /> Sign off the day</button>
+              </> : <p className="muted">Waiting for a checker to sign off.</p>)}
+              {close.status === "closed" && <p>Closed by <b>{close.closedBy}</b>. The day summary has gone to the AMCs.</p>}
+              {close.status === "open" && !canSubmitClose && <p className="muted">A maker submits the day close; you sign it off.</p>}
+              <button className="btn btn-outline btn-sm" onClick={daySummary}><Download size={13} /> Day summary (CSV)</button>
+            </div>
+          </div>
+        </section>
+      )}
+    </div>
+  );
+}
