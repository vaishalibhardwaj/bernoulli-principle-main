+import React from "react";
+import { useLocation } from "react-router-dom";
+import { useStore } from "@/state/store";
+import { screenForPath, CAPS, CAP_LABELS, hasCap, MODULE_BY_KEY } from "@/lib/access";
+import { Layers, Check, Minus } from "lucide-react";
+
+/** Brokerage / Posting / Refunds screens: shown to prove one access model serves every module. */
+export default function ModulePlaceholder() {
+  const { perms } = useStore();
+  const loc = useLocation();
+  const s = screenForPath(loc.pathname);
+  if (!s) return null;
+  const mod = MODULE_BY_KEY[s.module];
+  return (
+    <div data-testid="module-placeholder">
+      <div className="page-head">
+        <div>
+          <h1 style={{ display: "flex", alignItems: "center", gap: 10 }}><Layers size={24} style={{ color: mod.color }} /> {s.label}</h1>
+          <p>{mod.label} module. Out of scope for the recon prototype; it appears here because your roles grant it.</p>
+        </div>
+      </div>
+      <div className="card card-pad">
+        <h3 style={{ marginTop: 0 }}>What you can do on this screen</h3>
+        <div className="cap-strip">
+          {CAPS.map((c) => {
+            const offered = s.caps.includes(c); const on = hasCap(perms, s.key, c);
+            return <span key={c} className={"cap-pill" + (on ? " on" : "") + (offered ? "" : " na")}>{on ? <Check size={12} /> : <Minus size={12} />}{CAP_LABELS[c]}</span>;
+          })}
+        </div>
+        <p className="muted" style={{ marginTop: 14 }}>
+          The {mod.label} team registers its screens in the platform catalogue (Administration › Roles & Access › Screen catalogue). Admins then build roles for it. Users, roles, maker–checker,
+          segregation-of-duties checks and audit are shared with Reconciliation. The module needs no user-management code of its own.
+        </p>
+      </div>
+    </div>
+  );
+}
diff --color -ruN a/frontend/src/features/ops/charts.jsx b/frontend/src/features/ops/charts.jsx
--- a/frontend/src/features/ops/charts.jsx	1970-01-01 05:30:00
+++ b/frontend/src/features/ops/charts.jsx	2026-10-21 02:08:22
@@ -0,0 +1,70 @@
+import React from "react";
+
+/**
+ * Single-series line chart with crosshair + tooltip and an optional dashed target line.
+ * Thin 2px line, recessive grid, values in text ink (dataviz method: one hue, one axis).
+ */
+export function LineChart({ data, height = 200, min, max, target, format = (v) => v, label = "", id }) {
+  const ref = React.useRef(null);
+  const [w, setW] = React.useState(600);
+  const [hover, setHover] = React.useState(null);
+  React.useEffect(() => {
+    const ro = new ResizeObserver(([e]) => setW(Math.max(260, e.contentRect.width)));
+    if (ref.current) ro.observe(ref.current);
+    return () => ro.disconnect();
+  }, []);
+  const pad = { l: 40, r: 12, t: 12, b: 26 };
+  const lo = min ?? Math.min(...data.map((d) => d.v)); const hi = max ?? Math.max(...data.map((d) => d.v));
+  const x = (i) => pad.l + (i / (data.length - 1)) * (w - pad.l - pad.r);
+  const y = (v) => pad.t + (1 - (v - lo) / (hi - lo)) * (height - pad.t - pad.b);
+  const path = data.map((d, i) => `${i ? "L" : "M"}${x(i)},${y(d.v)}`).join(" ");
+  const area = `${path} L${x(data.length - 1)},${height - pad.b} L${x(0)},${height - pad.b} Z`;
+  const ticks = 4; const tv = Array.from({ length: ticks + 1 }, (_, i) => lo + ((hi - lo) * i) / ticks);
+  const onMove = (e) => {
+    const r = ref.current.getBoundingClientRect(); const px = e.clientX - r.left;
+    const i = Math.round(((px - pad.l) / (w - pad.l - pad.r)) * (data.length - 1));
+    setHover(Math.max(0, Math.min(data.length - 1, i)));
+  };
+  return (
+    <div className="lc" ref={ref} onPointerMove={onMove} onPointerLeave={() => setHover(null)} data-testid={id} role="img" aria-label={label}>
+      <svg width={w} height={height}>
+        {tv.map((v) => <g key={v}><line x1={pad.l} x2={w - pad.r} y1={y(v)} y2={y(v)} className="lc-grid" /><text x={pad.l - 8} y={y(v) + 4} className="lc-axis" textAnchor="end">{format(v)}</text></g>)}
+        {data.map((d, i) => (i % Math.ceil(data.length / 7) === 0 || i === data.length - 1) && <text key={i} x={x(i)} y={height - 8} className="lc-axis" textAnchor="middle">{d.label}</text>)}
+        {target != null && <g><line x1={pad.l} x2={w - pad.r} y1={y(target)} y2={y(target)} className="lc-target" /><text x={w - pad.r} y={y(target) - 5} textAnchor="end" className="lc-target-label">Target {format(target)}</text></g>}
+        <path d={area} className="lc-area" />
+        <path d={path} className="lc-line" />
+        <circle cx={x(data.length - 1)} cy={y(data[data.length - 1].v)} r="4" className="lc-dot" />
+        {hover != null && <g><line x1={x(hover)} x2={x(hover)} y1={pad.t} y2={height - pad.b} className="lc-cross" /><circle cx={x(hover)} cy={y(data[hover].v)} r="5" className="lc-dot hover" /></g>}
+      </svg>
+      {hover != null && (
+        <div className="lc-tip" style={{ left: Math.min(w - 140, Math.max(0, x(hover) - 60)), top: Math.max(0, y(data[hover].v) - 58) }}>
+          <b>{format(data[hover].v)}</b><span>{data[hover].label}{data[hover].note ? ` · ${data[hover].note}` : ""}</span>
+        </div>
+      )}
+    </div>
+  );
+}
+
+/** Tiny trend line for KPI tiles and table rows (no axes; the number beside it carries the value). */
+export function Spark({ values, width = 90, height = 28, bad }) {
+  const lo = Math.min(...values); const hi = Math.max(...values) || 1;
+  const pts = values.map((v, i) => `${(i / (values.length - 1)) * width},${height - 2 - ((v - lo) / (hi - lo || 1)) * (height - 4)}`).join(" ");
+  return <svg width={width} height={height} className={"spark-svg" + (bad ? " bad" : "")} aria-hidden="true"><polyline points={pts} /></svg>;
+}
+
+/** Horizontal bars with per-bar hover (value + share). One hue: magnitude, not identity. */
+export function BarList({ rows, total, format = (v) => v }) {
+  const max = Math.max(...rows.map((r) => r.v), 1);
+  return (
+    <div className="barlist">
+      {rows.map((r) => (
+        <div key={r.label} className={"bl-row" + (r.tone ? " " + r.tone : "")} title={`${r.label}: ${format(r.v)}${total ? ` (${((r.v / total) * 100).toFixed(1)}%)` : ""}`}>
+          <span className="bl-label">{r.label}</span>
+          <span className="bl-track"><i style={{ width: `${Math.max(1, (r.v / max) * 100)}%` }} /></span>
+          <b className="tnum">{format(r.v)}</b>
+          {total && <span className="bl-pct tnum">{((r.v / total) * 100).toFixed(1)}%</span>}
+        </div>
+      ))}
+    </div>
+  );
+}
diff --color -ruN a/frontend/src/features/ops/ui.js b/frontend/src/features/ops/ui.js
--- a/frontend/src/features/ops/ui.js	1970-01-01 05:30:00
+++ b/frontend/src/features/ops/ui.js	2026-10-21 02:08:22
@@ -0,0 +1,68 @@
+import React from "react";
+import { Lock, CheckCircle2, AlertTriangle, XCircle } from "lucide-react";
+import { useStore } from "@/state/store";
+
+/** ₹ in Indian short form: 2.15 Cr, 4.3 L, 12,500 */
+export function inrShort(n) {
+  if (n == null) return "—";
+  const a = Math.abs(n);
+  if (a >= 1e7) return "₹" + (n / 1e7).toFixed(2) + " Cr";
+  if (a >= 1e5) return "₹" + (n / 1e5).toFixed(2) + " L";
+  return "₹" + Math.round(n).toLocaleString("en-IN");
+}
+export const inr = (n) => (n < 0 ? "−₹" : "₹") + Math.abs(Number(n || 0)).toLocaleString("en-IN", { maximumFractionDigits: 2 });
+export const num = (n) => Number(n || 0).toLocaleString("en-IN");
+
+export function PhaseBadge({ phase, children }) {
+  return <span className={"phase-banner " + phase.toLowerCase()}><b>{phase}</b>{children}</span>;
+}
+
+/** Confidence meter 0–1 with threshold colouring. */
+export function Conf({ value, auto = 0.95, review = 0.6, id }) {
+  const { simple } = useStore();
+  const tone = value >= auto ? "hi" : value >= review ? "mid" : "lo";
+  if (simple) return <Light tone={tone === "hi" ? "green" : tone === "mid" ? "amber" : "red"} id={id}>{tone === "hi" ? "High" : tone === "mid" ? "Check needed" : "Low — check carefully"}</Light>;
+  return (
+    <span className={"conf " + tone} data-testid={id} title={`Confidence ${(value * 100).toFixed(0)}%`}>
+      <i style={{ width: `${Math.round(value * 100)}%` }} />
+      <b>{(value * 100).toFixed(0)}%</b>
+    </span>
+  );
+}
+
+export function Stat({ label, value, sub, tone, onClick, id }) {
+  return (
+    <button className={"ops-stat" + (tone ? " tone-" + tone : "")} onClick={onClick} data-testid={id} disabled={!onClick}>
+      <span className="os-label">{label}</span>
+      <span className="os-value tnum">{value}</span>
+      {sub && <span className="os-sub">{sub}</span>}
+    </button>
+  );
+}
+
+/** Hours → "2d 4h" */
+export function dur(h) {
+  if (h <= 0) return "overdue";
+  const d = Math.floor(h / 24); const r = Math.round(h % 24);
+  return d ? `${d}d ${r}h` : `${r}h`;
+}
+
+export function ReadOnlyNote({ what }) {
+  const { simple } = useStore();
+  if (simple) return <div className="note" style={{ marginBottom: 12 }}><Lock size={14} /><div>You can look at this page. Changes here are made by your team lead.</div></div>;
+  return <div className="note" style={{ marginBottom: 12 }}><Lock size={14} /><div>Read-only: your roles don't include the <b>{what}</b> capability on this screen.</div></div>;
+}
+
+/** Traffic light used by the simple view instead of numbers. */
+export function Light({ tone, children, id }) {
+  const Icon = tone === "green" ? CheckCircle2 : tone === "amber" ? AlertTriangle : XCircle;
+  return <span className={"light " + tone} data-testid={id}><Icon size={13} />{children}</span>;
+}
+
+/** Simple-view time left before delayed interest: words, not "1d 4h". */
+export function timeLeftWords(h) {
+  if (h <= 0) return "Late — penalty already running";
+  if (h < 24) return `Only ${Math.max(1, Math.round(h))} hours left`;
+  const d = Math.round(h / 24);
+  return `${d} day${d > 1 ? "s" : ""} left`;
+}
