+    id: r.id, kind: "Access", title: r.kind === "assign" ? "Grant a privileged role" : `Role change: ${r.draft?.name}`, detail: r.note || "", owner: r.requestedBy, priority: 8, review: "/admin/roles",
+  }));
+
+  items.sort((a, b) => a.priority - b.priority);
+  return items;
+}
