+          ))}</tbody>
+        </table>
+      </div>
+      {rel.status === "released" && <div className="next-strip"><span>Fund release done.</span><button className="btn btn-primary btn-sm" onClick={() => nav("/refunds")}>Next: Send refunds <ArrowRight size={13} /></button></div>}
+    </div>
+  );
+}
