+              <button className="btn btn-outline btn-sm" disabled={!canExport} onClick={r.run}><Download size={13} /> CSV</button>
+            </div>
+          ))}
+        </div>
+      ))}
+    </div>
+  );
+}
diff --color -ruN a/frontend/src/features/reports/csv.js b/frontend/src/features/reports/csv.js
