+          <p>Is today on track, where is the money at risk, and who needs help. For team leads.</p>
+        </div>
+        <div className="actions"><div className="segmented">{[[7, "7 days"], [14, "14 days"]].map(([v, l]) => <button key={v} className={range === v ? "on" : ""} onClick={() => setRange(v)}>{l}</button>)}</div></div>
+      </div>
+
+      <div className="kpi-cards">
+        {kpis.map((k) => (
+          <button key={k.label} className="kpi-card" onClick={k.onClick} disabled={!k.onClick}>
+            <span className="kc-label">{k.label}</span>
+            <div className="kc-row"><b className="tnum">{k.value}</b><Spark values={k.spark} bad={!k.good} /></div>
+            <span className={"kc-delta " + ((k.delta >= 0) === k.upIsGood ? "up" : "down")}>{k.delta >= 0 ? <ArrowUpRight size={12} /> : <ArrowDownRight size={12} />}{Math.abs(k.delta).toFixed(k.delta % 1 ? 1 : 0)} {k.unit}</span>
+            <span className="kc-note">{k.note}</span>
+          </button>
+        ))}
+      </div>
+
+      <section className="card dash-section"><div className="card-head"><h3>Today's cycle</h3><span className="muted">{steps.filter((s) => s.state === "done").length}/6 done</span></div><div className="card-pad"><CycleStepper steps={steps} /></div></section>
+
+      <div className="dash-2">
