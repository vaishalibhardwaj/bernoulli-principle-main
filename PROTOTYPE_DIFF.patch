+                <td className="tnum r">{last.toFixed(1)}%</td>
+                <td className={"tnum r " + (last < prev - 4 ? "neg" : "")}>{(last - prev >= 0 ? "+" : "") + (last - prev).toFixed(1)}</td>
+                <td>{bf.length ? (bad ? <span className="pill pill-pending"><span className="dot" />{bad} of {bf.length} need attention</span> : <span className="pill pill-active"><span className="dot" />{bf.length} clean</span>) : <span className="muted">—</span>}</td>
+              </tr>
+            );
+          })}</tbody>
+        </table>
+      </div>
+    </div>
+  );
+}
