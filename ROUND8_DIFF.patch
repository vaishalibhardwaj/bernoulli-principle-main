+            <span className="ac-label">{c.label}</span>
+            <b className="tnum">{c.n}</b>
+            <span className="tnum">{inrShort(c.amt)}</span>
+            <i style={{ width: `${(c.n / maxN) * 100}%` }} />
+          </button>
