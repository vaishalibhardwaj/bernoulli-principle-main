@@ -0,0 +1,156 @@
+import React from "react";
+import { useNavigate } from "react-router-dom";
+import { useStore } from "@/state/store";
+import { hasCap } from "@/lib/access";
+import { PLAIN_EXCEPTION } from "@/lib/plain";
+import { inr, Light, timeLeftWords } from "@/features/ops/ui";
+import { useMatchActions, isFastTrack } from "@/features/match/matchActions";
+import { CheckCircle2, Hourglass, PartyPopper } from "lucide-react";
+import { toast } from "sonner";
+
+const TONE_ORDER = { red: 0, amber: 1, green: 2 };
+
+/**
+ * My Work — the one queue for daily users. Every row says, in plain words, what happened
+ * and has ONE main button. Red first, then amber, then green.
+ */
+export default function MyWork() {
+  const { collections, perms, personaUser, act, audit } = useStore();
+  const nav = useNavigate();
+  const { acceptSuggestion, dismissSuggestion, byId, credits, purchases } = useMatchActions();
+  const me = personaUser.name;
+  const first = me.split(" ")[0];
+  const exceptions = collections.exceptions || [];
+
+  const take = (e) => {
+    const res = act({ screen: "exceptions", cap: "edit", kind: "exceptions", id: e.id, patch: { owner: me, status: "in_progress" }, audit: { entityLabel: `${e.ref} · ${e.type}`, action: "Assign", comment: `Picked up by ${me}` } });
+    if (res.ok) toast.success("It's yours now. Open it when you're ready.");
+  };
+
+  const items = [];
+
+  // 1) Problem cases: mine, plus urgent ones nobody has picked up
+  if (hasCap(perms, "exceptions", "view")) {
+    exceptions.filter((e) => ["open", "in_progress"].includes(e.status) && (e.owner === me || (!e.owner && e.amount > 0 && e.interestHoursLeft < 24))).forEach((e) => {
+      const mine = e.owner === me;
+      const hasClock = e.amount > 0;
+      const tone = hasClock && e.interestHoursLeft < 24 ? "red" : hasClock && e.interestHoursLeft < 72 ? "amber" : "green";
+      items.push({
+        id: e.id, tone, sort: hasClock ? e.interestHoursLeft : 999,
+        kind: "Problem case",
+        title: PLAIN_EXCEPTION[e.type] || e.type,
+        detail: `${e.investor !== "—" ? e.investor + " · " : ""}${e.amount ? inr(e.amount) : e.bankName}`,
+        when: hasClock ? timeLeftWords(e.interestHoursLeft) : null,
+        hint: mine ? `What to do: ${e.suggestion.action.replace("Open in Match Workbench", "Find the matching purchase").replace("Open File Inbox", "Check the bank file")}` : "Nobody is working on this yet",
+        primary: mine ? { label: "Open case", run: () => nav(`/exceptions?case=${e.id}`) } : { label: "Take this case", run: () => take(e) },
+        canAct: hasCap(perms, "exceptions", "edit"),
+      });
+    });
+  }
+
+  // 2) Payments the system thinks it has matched — needs a yes / no
+  if (hasCap(perms, "match", "view")) {
+    (collections.suggestions || []).filter((s) => !s.decided).forEach((s) => {
+      const cs = s.credits.map((id) => byId(credits, id)).filter(Boolean);
+      const ps = s.purchases.map((id) => byId(purchases, id)).filter(Boolean);
+      if (!cs.length || !ps.length) return;
+      const amount = cs.reduce((a, c) => a + c.amount, 0);
+      const sure = s.confidence >= 0.9;
+      items.push({
+        id: s.id, tone: sure ? "green" : "amber", sort: 500 + (1 - s.confidence) * 100,
+        kind: "Match a payment",
+        title: cs.length > 1 ? `${cs.length} payments from ${cs[0].remitter} add up to ${ps[0].investor}'s purchase`
+          : ps.length > 1 ? `One payment from ${cs[0].remitter} covers ${ps.length} purchases by ${ps[0].investor}`
+          : `Payment from ${cs[0].remitter} looks like ${ps[0].investor}'s purchase`,
+        detail: `${inr(amount)} · ${ps.map((p) => p.appNo).join(", ")}`,
+        light: sure ? "Very likely" : "Please check",
+        hint: isFastTrack(s.confidence, amount) ? "If you say yes, it's done — no approval needed" : "If you say yes, your team lead approves it",
+        primary: { label: "Yes, match", run: () => acceptSuggestion(s) },
+        secondary: { label: "Not a match", run: () => dismissSuggestion(s) },
+        more: { label: "See why", run: () => nav("/match") },
+        canAct: hasCap(perms, "match", "edit"),
+      });
+    });
+  }
+
+  // 3) PDFs / emails where the system wasn't sure of some values
+  if (hasCap(perms, "extraction", "view")) {
+    (collections.documents || []).filter((d) => d.status === "needs_review").forEach((d) => {
+      const flagged = d.fields.filter((f) => f.conf < 0.95 || (f.validator && !f.validator.ok)).length
+        + d.lines.reduce((n, l) => n + Object.values(l).filter((v) => v[1] < 0.95).length, 0);
+      items.push({
+        id: d.id, tone: "amber", sort: 600,
+        kind: "Check a document",
+        title: `Check ${flagged} value${flagged !== 1 ? "s" : ""} the system wasn't sure about`,
+        detail: `${d.docType} · ${d.name}`,
+        hint: "Everything else on it was read correctly",
+        primary: { label: "Check values", run: () => nav(`/extraction?doc=${d.id}`) },
+        canAct: hasCap(perms, "extraction", "edit"),
+      });
+    });
+  }
+
+  items.sort((a, b) => TONE_ORDER[a.tone] - TONE_ORDER[b.tone] || a.sort - b.sort);
+
+  const waiting = [
+    ...(collections.matches || []).filter((m) => m.status === "pending" && m.owner === first).map((m) => `Match of ${inr(m.amount)}`),
+    ...exceptions.filter((e) => e.status === "pending_approval" && (e.closedBy === first || e.owner === me)).map((e) => `${PLAIN_EXCEPTION[e.type] || e.type} (${e.ref})`),
+    ...(collections.documents || []).filter((d) => d.status === "pending_checker" && d.owner === first).map((d) => d.name),
+  ];
+
+  const today = new Date().toDateString();
+  const doneToday = audit.filter((a) => a.user === first && !a.denied && new Date(a.ts).toDateString() === today && /match|closure|extraction|Assign|Ran|Create refund|Mark/i.test(a.action)).length;
+  const hour = new Date().getHours();
