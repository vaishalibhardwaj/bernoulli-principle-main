+        </div>
+        <div className="mw-done"><CheckCircle2 size={18} /> <b>{doneToday}</b> done today</div>
+      </div>
+
+      <div className="mw-key">
+        <Light tone="red">Urgent — do first</Light>
+        <Light tone="amber">Please check</Light>
+        <Light tone="green">Quick — usually just say yes</Light>
+      </div>
+
+      <div className="mw-list">
+        {items.map((it, i) => (
+          <div key={it.id} className={"mw-item tone-" + it.tone} data-testid={"mw-item-" + it.id}>
+            <span className="mw-num">{i + 1}</span>
+            <div className="mw-body">
+              <div className="mw-kind">{it.kind}{it.light && <Light tone={it.tone}>{it.light}</Light>}</div>
+              <div className="mw-title">{it.title}</div>
+              <div className="mw-detail">{it.detail}</div>
+              <div className="mw-hint">{it.when && <span className={"mw-when " + it.tone}><Hourglass size={13} /> {it.when}</span>}{it.hint}</div>
+            </div>
+            {it.canAct ? (
+              <div className="mw-actions">
+                <button className="btn btn-primary mw-btn" onClick={it.primary.run} data-testid={"mw-do-" + it.id}>{it.primary.label}</button>
+                {it.secondary && <button className="btn btn-outline mw-btn-2" onClick={it.secondary.run} data-testid={"mw-no-" + it.id}>{it.secondary.label}</button>}
