+    if (!r.ok) { toast.error(r.error); return; }
+    setStatus(m.debits, "liab_debits", yes ? "matched" : "open"); setStatus(m.payouts, "liab_payouts", yes ? "matched" : "open");
+    toast.success(yes ? "Payout confirmed" : "Returned to the open pool");
+  };
