diff --color -ruN a/frontend/src/features/cutoffs/Cutoffs.jsx frontend/src/features/cutoffs/Cutoffs.jsx
--- a/frontend/src/features/cutoffs/Cutoffs.jsx	1970-01-01 05:30:00
+++ b/frontend/src/features/cutoffs/Cutoffs.jsx	2026-10-22 17:48:43
@@ -0,0 +1,79 @@
+import React from "react";
+import { Clock, Check, X, Lock } from "lucide-react";
+import { useStore } from "@/state/store";
+import { hasCap } from "@/lib/access";
+import { Note } from "@/components/bits";
+import { formatDate } from "@/lib/format";
+import { toast } from "sonner";
+
+/** Cutoff for an account: a scheme-level time wins, then its asset class, then 3:00 PM. */
+export function cutoffFor(cutoffs, assetClass, schemeCode) {
+  const live = (cutoffs || []).filter((c) => c.status === "active");
+  const s = live.find((c) => c.level === "scheme" && c.key === schemeCode);
+  if (s) return s.time;
+  const a = live.find((c) => c.level === "asset" && assetClass && assetClass.startsWith(c.key));
+  return a ? a.time : "15:00";
+}
+export const fmtTime = (t) => { const [h, m] = t.split(":").map(Number); return `${((h + 11) % 12) + 1}:${String(m).padStart(2, "0")} ${h < 12 ? "AM" : "PM"}`; };
+
+/**
+ * Same-day NAV cutoffs by asset class and scheme. Scheme-master times are reused read-only;
+ * recon keeps its own asset-class times only where the scheme master has none. Changes are maker–checker.
+ */
+export default function Cutoffs() {
+  const { collections, perms, act, currentUser } = useStore();
+  const rows = collections.cutoffs || [];
+  const canEdit = hasCap(perms, "cutoffs", "edit");
+  const canApprove = hasCap(perms, "cutoffs", "approve");
+  const [edit, setEdit] = React.useState({});
+
+  const propose = (r) => {
+    const t = edit[r.id];
+    if (!/^\d{2}:\d{2}$/.test(t || "")) { toast.error("Use HH:MM, e.g. 15:00"); return; }
+    const res = act({ screen: "cutoffs", cap: "edit", kind: "cutoffs", id: r.id, patch: { proposed: t, status: "pending", owner: currentUser }, audit: { entityLabel: `Cutoff · ${r.label}`, action: "Propose cutoff change", from: r.time, to: t } });
+    if (!res.ok) toast.error(res.error); else { toast.success("Sent to a checker"); setEdit({ ...edit, [r.id]: undefined }); }
+  };
+  const decide = (r, yes) => {
+    const res = act({ screen: "cutoffs", cap: "approve", kind: "cutoffs", id: r.id, target: r, patch: yes ? { time: r.proposed, proposed: null, status: "active", approvedBy: currentUser, updatedAt: new Date().toISOString() } : { proposed: null, status: "active" }, audit: { entityLabel: `Cutoff · ${r.label}`, action: yes ? "Approve cutoff change" : "Reject cutoff change", from: r.time, to: yes ? r.proposed : r.time } });
+    if (!res.ok) toast.error(res.error); else toast.success(yes ? "Cutoff updated" : "Change rejected");
+  };
+
+  const group = (level, title, sub) => (
+    <div className="card" style={{ marginBottom: 16 }}>
+      <div className="card-head"><h3>{title}</h3><span className="muted">{sub}</span></div>
+      <table className="grid">
+        <thead><tr><th>{level === "scheme" ? "Scheme" : "Asset class"}</th><th>Cutoff</th><th>Source</th><th>Status</th><th /></tr></thead>
+        <tbody>{rows.filter((r) => r.level === level).map((r) => (
+          <tr key={r.id} data-testid={"cutoff-" + r.id}>
+            <td><b>{r.label}</b></td>
+            <td className="tnum">{fmtTime(r.time)}{r.proposed && <span className="muted"> → {fmtTime(r.proposed)}</span>}</td>
+            <td>{r.source === "Scheme master" ? <span className="chip chip-previous"><Lock size={10} /> Scheme master</span> : <span className="chip chip-auto">Recon setup</span>}</td>
+            <td>{r.status === "pending" ? <span className="pill pill-pending"><span className="dot" />Pending for approval</span> : <span className="pill pill-active"><span className="dot" />Active</span>}</td>
+            <td>
+              {r.source !== "Scheme master" && r.status === "active" && canEdit && (
+                <span style={{ display: "flex", gap: 6 }}><input className="input tnum" style={{ width: 90 }} placeholder={r.time} value={edit[r.id] || ""} onChange={(e) => setEdit({ ...edit, [r.id]: e.target.value })} /><button className="btn btn-outline btn-sm" onClick={() => propose(r)}>Propose</button></span>
+              )}
+              {r.status === "pending" && canApprove && r.owner !== currentUser && (
+                <span style={{ display: "flex", gap: 6 }}><button className="btn btn-success btn-sm" onClick={() => decide(r, true)}><Check size={13} /> Approve</button><button className="btn btn-outline btn-sm" onClick={() => decide(r, false)}><X size={13} /> Reject</button></span>
+              )}
+              {r.source === "Scheme master" && <span className="muted">Change it in the scheme master{r.updatedAt ? ` · ${formatDate(r.updatedAt)}` : ""}</span>}
+            </td>
+          </tr>
+        ))}</tbody>
+      </table>
+    </div>
+  );
+
+  return (
+    <div data-testid="cutoffs">
+      <div className="page-head"><div>
+        <h1 style={{ display: "flex", alignItems: "center", gap: 10 }}><Clock size={22} /> Cutoff times</h1>
+        <p>When money must be in for same-day NAV. Used by the closing-balance view and fund release. A scheme-level time wins over its asset class.</p>
+      </div></div>
+      <Note kind="info">Where the scheme master already holds a cutoff, it is reused here read-only. Recon keeps its own times only for asset classes the scheme master doesn't cover. Changes need a checker.</Note>
+      <div style={{ height: 14 }} />
+      {group("scheme", "Scheme-level cutoffs", "From the scheme master")}
+      {group("asset", "Asset-class cutoffs", "Default for every scheme in the class")}
+    </div>
+  );
+}
diff --color -ruN a/frontend/src/features/dashboards/ClosingBalances.jsx frontend/src/features/dashboards/ClosingBalances.jsx
--- a/frontend/src/features/dashboards/ClosingBalances.jsx	1970-01-01 05:30:00
+++ b/frontend/src/features/dashboards/ClosingBalances.jsx	2026-10-22 17:59:49
@@ -0,0 +1,78 @@
+import React from "react";
+import { Banknote, Download, Clock, ArrowDownRight, AlertTriangle } from "lucide-react";
+import { useStore } from "@/state/store";
+import { inScope } from "@/lib/org";
+import { maskAccount, formatDateTime } from "@/lib/format";
+import { inr } from "@/features/ops/ui";
+import { cutoffFor, fmtTime } from "@/features/cutoffs/Cutoffs";
+import { downloadCsv } from "@/features/reports/csv";
+
+const minutesOf = (t) => { const [h, m] = t.split(":").map(Number); return h * 60 + m; };
+
+/**
+ * Closing balance per bank account: when its statement last came in and the last closing balance.
+ * Before an account's cutoff (same-day NAV), accounts with no statement yet are highlighted; after the cutoff
+ * they drop out for the day. Fund-utilisation debits are checked against the next closing balance.
+ */
+export default function ClosingBalances() {
+  const { collections, amcUser } = useStore();
+  const rows = (collections.balances || []).filter((r) => inScope(amcUser, r.amc));
+  const [asAt, setAsAt] = React.useState("now");
+  const [only, setOnly] = React.useState("all");
+  const nowMin = asAt === "now" ? new Date().getHours() * 60 + new Date().getMinutes() : minutesOf(asAt);
+
+  const enriched = rows.map((r) => {
+    const cut = cutoffFor(collections.cutoffs, r.assetClass, r.schemeCode);
+    const before = nowMin < minutesOf(cut);
+    const late = !r.uploadedToday && before;
+    const ignored = !r.uploadedToday && !before;
+    return { ...r, cut, late, ignored, minsLeft: minutesOf(cut) - nowMin };
+  }).sort((a, b) => (b.late - a.late) || (a.ignored - b.ignored) || a.bankName.localeCompare(b.bankName));
+  const shown = enriched.filter((r) => only === "all" || (only === "late" ? r.late : only === "util" ? r.util : r.source === "computed"));
+  const late = enriched.filter((r) => r.late).length;
+
+  const exportCsv = () => downloadCsv(`closing_balances_${new Date().toISOString().slice(0, 10)}.csv`, ["Bank", "Account", "Last uploaded", "Last closing balance", "Balance source", "Cutoff"],
+    shown.map((r) => [r.bankName, maskAccount(r.accountNumber), formatDateTime(r.lastUploadedAt), r.closing.toFixed(2), r.source === "computed" ? "Computed from our data" : "Bank statement", fmtTime(r.cut)]));
+
+  return (
+    <div data-testid="closing-balances">
+      <div className="page-head">
+        <div>
+          <h1 style={{ display: "flex", alignItems: "center", gap: 10 }}><Banknote size={22} /> Closing balances</h1>
+          <p>Every bank account: when its statement last came in and its last closing balance. Same-day NAV depends on statements arriving before the cutoff.</p>
+        </div>
+        <div className="actions">
+          <div className="segmented" title="See how the list looks at another time of day">{[["now", "Now"], ["12:00", "12:00 PM"], ["15:30", "3:30 PM"]].map(([v, l]) => <button key={v} className={asAt === v ? "on" : ""} onClick={() => setAsAt(v)} data-testid={"asat-" + v}>{l}</button>)}</div>
+          <button className="btn btn-outline btn-sm" onClick={exportCsv}><Download size={14} /> Export</button>
+        </div>
+      </div>
+
+      <div className="st-strip" style={{ gridTemplateColumns: "repeat(4, 1fr)" }}>
+        {[["all", "Accounts", enriched.length, ""], ["late", "Not uploaded — before cutoff", late, "amber"], ["util", "Fund-utilisation debits today", enriched.filter((r) => r.util).length, "blue"], ["computed", "Balance computed (bank gives none)", enriched.filter((r) => r.source === "computed").length, ""]].map(([k, l, v, t]) => (
+          <button key={k} className={"st-cell tone-" + t + (only === k ? " on" : "")} onClick={() => setOnly(k)} data-testid={"cb-" + k}><span>{l}</span><b className="fx-num">{v}</b></button>
+        ))}
+      </div>
+
+      <div className="card">
+        <table className="grid" data-testid="balance-table">
+          <thead><tr><th>Bank</th><th>Account</th><th>Last uploaded</th><th className="r">Last closing balance</th><th>Cutoff</th><th>Fund-utilisation check</th></tr></thead>
+          <tbody>{shown.map((r) => (
+            <tr key={r.id} className={r.late ? "row-late" : r.ignored ? "row-ignored" : ""} data-testid={"bal-" + r.id}>
+              <td><b>{r.bankName}</b></td>
+              <td className="tnum">{maskAccount(r.accountNumber)}<div className="muted" style={{ fontSize: 11 }}>{r.assetClass}</div></td>
+              <td className="tnum">{formatDateTime(r.lastUploadedAt)}
+                {r.late && <div className="late-note"><Clock size={11} /> Not uploaded today — cutoff {fmtTime(r.cut)}{r.minsLeft > 0 ? ` in ${Math.floor(r.minsLeft / 60)}h ${r.minsLeft % 60}m` : ""}</div>}
+                {r.ignored && <div className="muted" style={{ fontSize: 11 }}>Missed the {fmtTime(r.cut)} cutoff — not needed for today's NAV</div>}</td>
+              <td className="tnum r"><b>{inr(r.closing)}</b>{r.source === "computed" && <div className="computed-tag">computed from our data — bank gives no closing balance</div>}</td>
+              <td className="tnum">{fmtTime(r.cut)}</td>
+              <td>{r.util ? (r.util.ok
+                ? <span className="util ok"><ArrowDownRight size={12} /> {inr(r.util.amount)} debit at 11:20 went through — balance dropped from {inr(r.util.before)}</span>
+                : <span className="util bad"><AlertTriangle size={12} /> {inr(r.util.amount)} debit at 11:20 not visible — balance hasn't dropped. Check with the bank.</span>) : <span className="muted">—</span>}</td>
+            </tr>
+          ))}</tbody>
+        </table>
+      </div>
+      <p className="muted" style={{ marginTop: 10, fontSize: 12 }}>Cutoffs come from Setup → Cutoff times (scheme master first, then asset class). After an account's cutoff, a missing statement no longer affects today's NAV, so the row is greyed out instead of highlighted.</p>
+    </div>
+  );
+}
