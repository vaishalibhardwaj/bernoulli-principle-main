+.sd-facts b { font-size: 13.5px; font-weight: 500; color: #e6edf9; }
+.sd-actions { display: flex; gap: 10px; margin-top: 8px; flex-wrap: wrap; }
+.sd-next { display: flex; gap: 6px; align-items: center; padding: 0 6px; }
+@media (max-width: 1000px) { .split { grid-template-columns: 1fr; height: auto; } .split-list { max-height: 320px; } }
+
+/* ============================ Dashboard ============================ */
+.dash { display: flex; flex-direction: column; gap: 16px; }
+.dash > .page-head { margin-bottom: 4px; }
+.dash-hero { display: grid; grid-template-columns: 430px 1fr; gap: 16px; }
+.orb-card, .flow-card { border-radius: 18px !important; }
+.orb-card { background: radial-gradient(500px 300px at 30% 40%, rgba(11, 80, 157, .55), transparent 70%), var(--glass) !important; }
+.orb-wrap { display: flex; align-items: center; gap: 18px; padding: 10px 20px 22px; }
+.orb-facts { display: flex; flex-direction: column; gap: 10px; }
+.orb-facts > div { display: flex; flex-direction: column; }
+.orb-facts > div > span { font-size: 11.5px; color: #8aa3cc; }
+.orb-facts b { font-size: 20px; color: #fff; font-weight: 600; }
+.live-dot { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: #4ff0b4; }
+.live-dot::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #4ff0b4; box-shadow: 0 0 0 0 rgba(79, 240, 180, .7); animation: pulse 1.8s infinite; }
+@keyframes pulse { 70% { box-shadow: 0 0 0 10px rgba(79, 240, 180, 0); } 100% { box-shadow: 0 0 0 0 rgba(79, 240, 180, 0); } }
+.kpi-cards { margin-bottom: 0; }
+.kpi-card { border-radius: 14px !important; padding: 16px 18px; }
+.kc-label { color: #8aa3cc; }
+.kc-row b { color: #fff; font-weight: 600; }
+.kc-note { color: #7f93b8; }
+.dash-2 { margin-bottom: 0; }
+.dash .card { border-radius: 16px !important; }
+@media (max-width: 1180px) { .dash-hero { grid-template-columns: 1fr; } }
+
+.fx-num { font-size: inherit; color: inherit; }
+.dash-2 > *, .dash-hero > *, .deck-hero > * { min-width: 0; }
+.flow, .lc { min-width: 0; overflow: hidden; }
+.towers-wrap { min-height: 250px; }
+
+/* ============================ Admin ============================ */
+.admin-hero { display: grid; grid-template-columns: 1fr 300px; gap: 16px; margin-bottom: 18px; }
+.orbit-card { border-radius: 18px !important; background: radial-gradient(420px 300px at 30% 55%, rgba(11, 80, 157, .5), transparent 70%), var(--glass) !important; }
+.orbit-wrap { display: flex; align-items: center; gap: 24px; padding: 6px 22px 26px; }
+.orbit-side { flex: 1; display: flex; flex-direction: column; gap: 4px; }
+.om-row { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 10px; background: rgba(6, 13, 30, .45); border: 1px solid var(--edge); color: #e6edf9; font: inherit; font-size: 13.5px; cursor: pointer; text-align: left; }
+.om-row i { width: 10px; height: 10px; border-radius: 3px; background: var(--mc); box-shadow: 0 0 10px var(--mc); }
+.om-row b { margin-left: auto; font-size: 16px; font-weight: 600; }
+.om-row em { font-style: normal; font-size: 11.5px; color: #6cc3ff; padding: 2px 6px; border-radius: 5px; }
+.om-row em:hover { background: rgba(47, 140, 240, .2); }
+.om-row:hover, .om-row.on { border-color: color-mix(in srgb, var(--mc) 70%, transparent); box-shadow: 0 0 18px -6px var(--mc); }
+.access-health { display: grid; grid-template-rows: repeat(4, 1fr); gap: 10px; }
+.ah-tile { border-radius: 14px; padding: 12px 16px; background: var(--glass); border: 1px solid var(--edge); display: flex; flex-direction: column; justify-content: center; box-shadow: var(--shadow-card); position: relative; overflow: hidden; }
+.ah-tile::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: #39d0ff; box-shadow: 0 0 12px #39d0ff; }
+.ah-tile.tone-green::before { background: #4ff0b4; box-shadow: 0 0 12px #4ff0b4; }
+.ah-tile.tone-amber::before { background: #ffc56b; box-shadow: 0 0 12px #ffc56b; }
+.ah-tile.tone-red::before { background: #ff6b86; box-shadow: 0 0 12px #ff6b86; }
+.ah-tile > span { font-size: 12px; color: #8aa3cc; }
+.ah-tile b { font-size: 26px; color: #fff; font-weight: 600; }
+.user-management-page .role-badge, .user-management-page .us-pill { filter: none; }
+@media (max-width: 1100px) { .admin-hero { grid-template-columns: 1fr; } .access-health { grid-template-columns: repeat(2, 1fr); grid-template-rows: none; } }
+.sugg-focus { display: grid; grid-template-columns: 1fr 340px; gap: 16px; margin-bottom: 16px; align-items: start; }
+.sugg-card.focus { padding: 22px 24px; border-radius: 18px !important; gap: 14px; background: linear-gradient(150deg, rgba(30, 60, 120, .75), rgba(10, 22, 50, .9) 60%) !important; border-color: rgba(57, 208, 255, .28) !important; position: relative; }
+.sugg-card.focus .sc-sides { font-size: 14px; }
+.sugg-card.focus .sc-sides b { font-size: 20px; font-family: var(--font-display); color: #fff; }
+.sugg-card.focus .reasons { font-size: 13.5px; gap: 6px; }
+.sugg-card.focus .sc-actions .btn { font-size: 14px; padding: 10px 18px; }
+.sf-pos { position: absolute; right: 22px; top: 18px; font-family: var(--font-display); font-size: 20px; color: #fff; }
+.sf-pos em { font-style: normal; font-size: 12px; color: #7f93b8; }
+.sugg-rest { border-radius: 16px !important; }
+@media (max-width: 1100px) { .sugg-focus { grid-template-columns: 1fr; } }
+.sugg-card.focus .sc-head { padding-right: 76px; }
