+
+/* ---------- Generic surfaces ---------- */
+.card, .kpi, .kpi-card, .ops-stat, .cy-step, .journey-bar, .mw-item, .role-card, .role-tile, .rp-module, .role-block,
+.metric, .tile, .rev-card, .stat-card, .sugg-card, .pl-step, .ver-item, .why-cand, .mw-waiting, .report-group, .kpi-row > *, .release-hero,
+.mode-card, .dropzone, .preview-wrap, .summary-banner, .rev-section, .stepper, .wizard, .map-group, .date-bar, .sim-stats > div, .doc-page {
+  background: var(--glass) !important;
+  border: 1px solid var(--edge) !important;
+  box-shadow: var(--shadow-card) !important;
+  backdrop-filter: blur(14px) saturate(140%);
