+.btn-success { background: linear-gradient(135deg, #22c38e, #10916a); border: 1px solid rgba(47, 211, 155, .4); box-shadow: 0 8px 22px -8px rgba(34, 195, 142, .8); color: #fff; }
+.btn-danger { box-shadow: 0 8px 22px -8px rgba(255, 92, 122, .7); }
+.btn-fill { background: rgba(47, 140, 240, .14); color: #8cc6ff; border-color: rgba(47, 140, 240, .35); }
+.input, .select, .textarea { background: rgba(6, 13, 30, .7) !important; border-color: var(--edge-strong) !important; color: hsl(var(--text)) !important; box-shadow: none !important; }
+.input:focus, .select:focus, .textarea:focus { border-color: var(--cams-cyan) !important; box-shadow: 0 0 0 3px rgba(57, 208, 255, .18), 0 0 18px -6px var(--cams-cyan) !important; }
