+}
+.doc-page { background: rgba(6, 12, 28, .7) !important; color: #c9d6ee; }
+.sidebar { background: linear-gradient(180deg, rgba(8, 16, 36, .92), rgba(6, 12, 28, .96)); border-right: 1px solid var(--edge); backdrop-filter: blur(18px); }
+.sidebar-brand { border-bottom: 1px solid var(--edge); }
+.brand-mark { background: linear-gradient(135deg, var(--cams-blue), var(--cams-cyan)); box-shadow: var(--glow); }
