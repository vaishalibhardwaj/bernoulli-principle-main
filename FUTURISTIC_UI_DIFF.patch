+/* ============================================================================
+   CAMS "Command Deck" theme — dark glass, luminous CAMS blue, depth and glow.
+   Brand anchor: CAMS logo blue #0b509d and logo greys #929497 / #808184.
+   Loaded last: re-maps the design tokens, then restyles every surface.
+   ============================================================================ */
+:root {
+  --cams-blue: #0b509d;          /* logo blue */
+  --cams-blue-lit: #2f8cf0;      /* same hue, lifted for dark backgrounds */
+  --cams-cyan: #39d0ff;          /* glow accent */
+  --cams-grey: #929497;          /* logo grey */
+  --glow: 0 0 0 1px rgba(57, 208, 255, .25), 0 0 24px -4px rgba(47, 140, 240, .55);
+  --glass: linear-gradient(180deg, rgba(22, 37, 72, .78), rgba(11, 21, 44, .78));
+  --glass-strong: linear-gradient(180deg, rgba(28, 46, 88, .92), rgba(13, 25, 52, .92));
+  --edge: rgba(120, 165, 255, .16);
+  --edge-strong: rgba(120, 165, 255, .28);
+  --font-display: "Space Grotesk", "Inter", sans-serif;
+
+  --page: 223 62% 6%;
+  --card: 222 48% 12%;
+  --border: 220 38% 21%;
+  --border-strong: 220 32% 30%;
+  --text: 216 50% 94%;
+  --muted: 218 20% 66%;
+  --primary: 211 88% 56%;
+  --primary-hover: 211 92% 63%;
+  --primary-soft: 213 64% 17%;
+  --primary-soft-border: 212 58% 34%;
+  --primary-deep: 211 87% 33%;
+  --st-active: 158 72% 50%;
+  --st-pending: 38 100% 62%;
+  --st-rejected: 350 95% 66%;
+  --st-draft: 218 16% 64%;
+  --st-inactive: 218 12% 52%;
+  --shadow-card: inset 0 1px 0 rgba(255, 255, 255, .05), 0 12px 32px -14px rgba(0, 0, 0, .7);
+  --shadow-raised: 0 30px 60px -20px rgba(0, 0, 0, .8), 0 0 0 1px var(--edge-strong);
+  color-scheme: dark;
+}
+
+body {
+  background-color: hsl(var(--page));
+  background-image:
+    radial-gradient(1100px 620px at 8% -12%, rgba(11, 80, 157, .55), transparent 60%),
+    radial-gradient(900px 520px at 105% 0%, rgba(57, 208, 255, .14), transparent 60%),
+    radial-gradient(800px 600px at 60% 120%, rgba(47, 140, 240, .12), transparent 60%),
+    linear-gradient(rgba(120, 165, 255, .035) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(120, 165, 255, .035) 1px, transparent 1px);
+  background-size: auto, auto, auto, 44px 44px, 44px 44px;
+  background-attachment: fixed;
+  color: hsl(var(--text));
+}
+::selection { background: rgba(57, 208, 255, .3); }
