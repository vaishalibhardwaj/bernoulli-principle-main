+.cy-step:has(.cy-mine) { border-color: hsl(var(--text)); box-shadow: 0 0 0 3px hsl(var(--text) / .08); }
+/* Tailwind's .grid utility collides with our table.grid class — keep tables as tables */
+table.grid { display: table !important; }
+.clock { font-family: var(--font-ui); font-variant-numeric: tabular-nums; }
+.kc-row b { white-space: nowrap; font-size: clamp(18px, 1.6vw, 24px); }
