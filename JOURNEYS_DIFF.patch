diff --color -ruN r3a/frontend/src/components/CommandPalette.jsx r3b/frontend/src/components/CommandPalette.jsx
--- r3a/frontend/src/components/CommandPalette.jsx	1970-01-01 05:30:00
+++ r3b/frontend/src/components/CommandPalette.jsx	2026-10-21 02:08:22
@@ -0,0 +1,62 @@
+import React from "react";
+import { Command } from "cmdk";
+import { useNavigate } from "react-router-dom";
+import { useStore } from "@/state/store";
+import { navFor, screenLabel, PERSONAS } from "@/lib/access";
+import { PLAIN_EXCEPTION } from "@/lib/plain";
+import { Search, CornerDownLeft, ArrowRight, User } from "lucide-react";
+
+/** ⌘K: jump to any screen you can open, find a case or refund by reference, or switch demo persona. */
+export default function CommandPalette({ open, onClose }) {
+  const { perms, simple, collections, switchPersona } = useStore();
+  const nav = useNavigate();
+  React.useEffect(() => {
+    const h = (e) => e.key === "Escape" && onClose();
+    window.addEventListener("keydown", h);
+    return () => window.removeEventListener("keydown", h);
+  }, [onClose]);
+  if (!open) return null;
+  const go = (path) => { nav(path); onClose(); };
+  const screens = navFor(perms, simple).flatMap((m) => m.groups.flatMap((g) => g.screens.map((s) => ({ ...s, group: m.label }))));
+  const can = (k) => screens.some((s) => s.key === k);
+
+  return (
+    <div className="cmdk-overlay" onMouseDown={(e) => e.target === e.currentTarget && onClose()}>
+      <Command className="cmdk" label="Search" loop>
+        <div className="cmdk-input"><Search size={16} /><Command.Input autoFocus placeholder="Search screens, cases (EXC-…), refunds (RF-…)…" /><kbd>esc</kbd></div>
+        <Command.List className="cmdk-list">
+          <Command.Empty className="cmdk-empty">No results.</Command.Empty>
+          <Command.Group heading="Go to">
+            {screens.map((s) => (
+              <Command.Item key={s.key} value={`${screenLabel(s, simple)} ${s.group}`} onSelect={() => go(s.path)} className="cmdk-item">
+                <ArrowRight size={14} /><span>{screenLabel(s, simple)}</span><em>{s.group}</em>
+              </Command.Item>
+            ))}
+          </Command.Group>
+          {can("exceptions") && <Command.Group heading="Problem cases">
+            {(collections.exceptions || []).filter((e) => e.status !== "closed").slice(0, 40).map((e) => (
+              <Command.Item key={e.id} value={`${e.ref} ${e.investor} ${e.type}`} onSelect={() => go(`/exceptions?case=${e.id}`)} className="cmdk-item">
+                <span className="tnum">{e.ref}</span><span>{simple ? PLAIN_EXCEPTION[e.type] || e.type : e.type}</span><em>{e.investor}</em>
+              </Command.Item>
+            ))}
+          </Command.Group>}
+          {can("refunds") && <Command.Group heading="Refunds">
+            {(collections.refunds || []).map((r) => (
+              <Command.Item key={r.id} value={`${r.ref} ${r.investor} refund`} onSelect={() => go(`/refunds?refund=${r.id}`)} className="cmdk-item">
+                <span className="tnum">{r.ref}</span><span>{r.investor}</span><em>{r.reason}</em>
+              </Command.Item>
+            ))}
+          </Command.Group>}
+          <Command.Group heading="Demo: view as">
+            {PERSONAS.map((p) => (
+              <Command.Item key={p.id} value={`persona ${p.label}`} onSelect={() => { switchPersona(p.id); go("/"); }} className="cmdk-item">
+                <User size={14} /><span>{p.label}</span>
+              </Command.Item>
+            ))}
+          </Command.Group>
+        </Command.List>
+        <div className="cmdk-foot"><span><CornerDownLeft size={12} /> open</span><span>↑↓ move</span><span>⌘K toggle</span></div>
+      </Command>
+    </div>
+  );
+}
diff --color -ruN r3a/frontend/src/features/approvals/Approvals.jsx r3b/frontend/src/features/approvals/Approvals.jsx
--- r3a/frontend/src/features/approvals/Approvals.jsx	1970-01-01 05:30:00
+++ r3b/frontend/src/features/approvals/Approvals.jsx	2026-10-21 02:08:22
@@ -0,0 +1,71 @@
+import React from "react";
+import { useNavigate } from "react-router-dom";
+import { useStore } from "@/state/store";
+import { useApprovals } from "./useApprovals";
+import { Inbox, Check, X, ArrowRight, AlertTriangle, CheckCircle2 } from "lucide-react";
+import { toast } from "sonner";
+
+const KIND_ORDER = ["Fund release", "Bank file layout", "Refund", "Manual match", "Case closure", "Document", "Match rule", "Bank setup", "Credit MIS setup", "Column mapping", "Access", "Day close"];
+
+/** One inbox for checkers: everything every maker has submitted, most business-critical first. */
+export default function Approvals() {
+  const nav = useNavigate();
+  const { currentUser } = useStore();
+  const all = useApprovals();
+  const [kind, setKind] = React.useState("all");
+  const [sel, setSel] = React.useState([]);
+  const items = all.filter((a) => kind === "all" || a.kind === kind);
+  const counts = KIND_ORDER.map((k) => [k, all.filter((a) => a.kind === k).length]).filter(([, n]) => n);
+  const inline = (a) => a.approve || a.config;
+
+  const decide = (a, yes) => {
+    const fn = yes ? (a.approve || a.config?.approve) : a.reject;
+    if (!fn) return nav(a.review);
+    const res = fn();
+    if (res && res.ok === false) { toast.error(res.error); return false; }
+    return true;
+  };
+  const bulk = () => {
+    let n = 0; items.filter((a) => sel.includes(a.id)).forEach((a) => { if (decide(a, true)) n++; });
+    toast.success(`${n} item${n !== 1 ? "s" : ""} approved`); setSel([]);
+  };
+
+  return (
+    <div data-testid="approvals-inbox">
+      <div className="page-head">
+        <div>
+          <h1 style={{ display: "flex", alignItems: "center", gap: 10 }}><Inbox size={22} /> Approvals</h1>
+          <p>Everything your team has sent for a second check, from every screen. Items that hold up today's fund release are at the top.</p>
+        </div>
+        {sel.length > 0 && <div className="actions"><button className="btn btn-success" onClick={bulk} data-testid="bulk-approve"><Check size={14} /> Approve {sel.length} selected</button></div>}
+      </div>
+
+      <div className="chip-row" style={{ marginBottom: 14 }}>
+        <button className={"filter-chip" + (kind === "all" ? " on" : "")} onClick={() => setKind("all")}>All <b>{all.length}</b></button>
+        {counts.map(([k, n]) => <button key={k} className={"filter-chip" + (kind === k ? " on" : "")} onClick={() => setKind(k)}>{k} <b>{n}</b></button>)}
+      </div>
+
+      <div className="card">
+        {items.length === 0 && <div className="mw-empty"><CheckCircle2 size={30} /><h2>Inbox zero</h2><p className="muted">Nothing is waiting for your approval.</p></div>}
+        {items.map((a) => (
+          <div key={a.kind + a.id} className={"ap-row" + (a.urgent ? " urgent" : "")} data-testid={"ap-" + a.id}>
+            <input type="checkbox" className="cb" disabled={a.own || !inline(a)} checked={sel.includes(a.id)} onChange={() => setSel((s) => s.includes(a.id) ? s.filter((x) => x !== a.id) : [...s, a.id])} aria-label="Select" />
+            <span className="ap-kind">{a.kind}</span>
+            <div className="ap-main">
+              <div className="ap-title">{a.urgent && <AlertTriangle size={13} className="ap-urgent" />}{a.title}</div>
+              <div className="muted">{a.detail}{a.owner && <> · from <b>{a.owner}</b></>}</div>
+            </div>
+            {a.own ? <span className="pill pill-pending"><span className="dot" />Your own — another checker approves</span> : (
+              <div className="ap-actions">
+                {a.review && <button className="btn btn-outline btn-sm" onClick={() => nav(a.review)}>Review <ArrowRight size={12} /></button>}
+                {a.reject && <button className="btn btn-ghost btn-sm" onClick={() => decide(a, false) && toast("Sent back to " + (a.owner || "the maker"))}><X size={13} /> Send back</button>}
+                {inline(a) && <button className="btn btn-success btn-sm" onClick={() => decide(a, true) && toast.success(`${a.kind} approved`)} data-testid={"ap-approve-" + a.id}><Check size={13} /> Approve</button>}
+              </div>
+            )}
+          </div>
+        ))}
+      </div>
+      <p className="muted" style={{ marginTop: 10 }}>Signed in as {currentUser}. You can't approve anything you created; those items show as "your own".</p>
+    </div>
+  );
+}
diff --color -ruN r3a/frontend/src/features/approvals/useApprovals.js r3b/frontend/src/features/approvals/useApprovals.js
--- r3a/frontend/src/features/approvals/useApprovals.js	1970-01-01 05:30:00
+++ r3b/frontend/src/features/approvals/useApprovals.js	2026-10-21 02:08:22
@@ -0,0 +1,75 @@
+import { useStore } from "@/state/store";
+import { hasCap } from "@/lib/access";
+import { PLAIN_EXCEPTION } from "@/lib/plain";
+import { inr, inrShort } from "@/features/ops/ui";
+import { maskAccount } from "@/lib/format";
+import { delayedInterest } from "@/mock/opsSeed";
+import { useMatchActions } from "@/features/match/matchActions";
+
+/**
+ * Everything waiting for a checker, from every screen, in one list.
+ * Simple items can be approved inline; ones that need a diff/impact review link to their screen.
+ */
+export function useApprovals() {
+  const { collections: c, perms, act, approve, currentUser } = useStore();
+  const { setStatus } = useMatchActions();
+  const items = [];
+  const mine = (owner) => owner && (owner === currentUser || owner.split(" ")[0] === currentUser);
+  const add = (screen, it) => { if (hasCap(perms, screen, "approve")) items.push({ screen, own: mine(it.owner), ...it }); };
+
+  // Fund release first (it gates unit allotment); day close last (it signs off everything else)
+  (c.dayclose || []).filter((d) => d.status === "pending").forEach((d) => add("release", {
+    id: d.id, kind: "Day close", title: "Sign off today's reconciliation", detail: `${d.carried} item${d.carried !== 1 ? "s" : ""} carried forward · notes: ${d.note || "—"}`, owner: d.submittedBy, priority: 9,
+    approve: () => act({ screen: "release", cap: "approve", kind: "dayclose", id: d.id, target: { owner: d.submittedBy }, patch: { status: "closed", closedBy: currentUser, closedAt: new Date().toISOString() }, audit: { entityLabel: "Day close", action: "Sign off day", from: "Pending", to: "Closed" } }),
+    reject: () => act({ screen: "release", cap: "approve", kind: "dayclose", id: d.id, target: { owner: d.submittedBy }, patch: { status: "open" }, audit: { entityLabel: "Day close", action: "Return day close", from: "Pending", to: "Open" } }),
+  }));
+  (c.releases || []).filter((r) => r.status === "pending").forEach((r) => add("release", {
+    id: r.id, kind: "Fund release", title: `Release ${inrShort(r.amount)} to Transaction Posting`, detail: `${r.count.toLocaleString("en-IN")} realised payments · ${r.ref} · cut-off 3:00 PM`, owner: r.preparedBy, priority: 1, urgent: true,
+    approve: () => act({ screen: "release", cap: "approve", kind: "releases", id: r.id, target: { owner: r.preparedBy }, patch: { status: "released", approvedBy: currentUser, releasedAt: new Date().toISOString() }, audit: { entityLabel: r.ref, action: "Release funds to Posting", from: "Pending", to: "Released", comment: inr(r.amount) } }),
+    reject: () => act({ screen: "release", cap: "approve", kind: "releases", id: r.id, target: { owner: r.preparedBy }, patch: { status: "not_started" }, audit: { entityLabel: r.ref, action: "Return release batch", from: "Pending", to: "Not prepared" } }),
+  }));
+  (c.refunds || []).filter((r) => r.status === "pending").forEach((r) => {
+    const int = delayedInterest(r.amount, r.ageDays);
+    add("refunds", {
+      id: r.id, kind: "Refund", title: `Refund ${inr(r.amount + int)} to ${r.investor}`, detail: `${r.reason} · ${r.bankAcct} · ${r.verified ? "account verified ✓" : "account NOT verified"}${int ? ` · incl. ${inr(int)} delayed interest` : ""}`, owner: r.owner, priority: 2, urgent: r.ageDays >= 4,
