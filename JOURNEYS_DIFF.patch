+/* ============================================================================
+   Theme layer — calm, dense, precise (Stripe / Modern Treasury direction).
+   Loaded last; overrides tokens and base components, adds journey components.
+   ============================================================================ */
+:root {
+  --primary: 244 88% 62%;
+  --primary-hover: 244 75% 55%;
+  --primary-soft: 244 100% 97.5%;
+  --primary-soft-border: 244 80% 91%;
+  --page: 216 33% 97.5%;
+  --border: 216 22% 91%;
+  --border-strong: 216 16% 84%;
+  --text: 226 34% 15%;
+  --muted: 220 11% 46%;
+  --st-active: 152 62% 34%;
+  --st-pending: 34 92% 44%;
+  --st-rejected: 354 70% 50%;
+  --radius-card: 10px;
+  --radius-input: 7px;
+  --shadow-card: 0 1px 1px hsl(226 34% 15% / .03), 0 1px 3px hsl(226 34% 15% / .05);
+  --shadow-raised: 0 12px 32px -8px hsl(226 34% 15% / .18), 0 4px 10px -4px hsl(226 34% 15% / .08);
+  --font-ui: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+body { background: hsl(var(--page)); background-image: none; font-size: 13.5px; letter-spacing: -0.006em; font-feature-settings: "cv11", "ss01"; }
+.tnum, table.grid .tnum, .input.tnum { font-family: var(--font-ui) !important; font-variant-numeric: tabular-nums; font-size: inherit; }
+.r { text-align: right !important; }
+.neg { color: hsl(var(--st-rejected)); font-weight: 600; }
+
